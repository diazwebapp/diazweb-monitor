<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		
		<h1>Astro</h1>
		<div class="card-input" >
			<input type="url" name="url" placeholder="https://tuCulito.com" id="url" required>
			<button>Test</button>
		</div>
		<div class="card-result" >
			<div id="result">
				<div id="mobile">

				</div>
				<div id="desktop">

				</div>
			</div>
		</div>
	</body>
</html>

<style>
	*, *::after,*::before{
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	body{
		min-height: 100vh;
		display: grid;
		grid-template-columns: 1fr;
	}
	.card-input{
		width: 300px;
		margin: 10px auto;
		input, button{
			width: 100%;
			font-size: 22px;
			padding: 10px;
		}
	}
	#result{
		width:100%;
		display:grid;
		grid-template-columns:320px 1fr;
		grid-gap: 10px;
		border:2px solid red;
		&div{
			border: 2px solid green;
		}
		&img{
			width: 100%;
			height: auto;
			object-fit: contain;
			max-width: 100%;
			max-height: 100%;
		}
	}
</style>
<script>
	const btnTest = document.querySelector('button')
	if(btnTest){
		btnTest.addEventListener('click', async () => {
			btnTest.disabled = true
			const url = document.getElementById("url") as HTMLInputElement
			if(!url) return
			const {message,desktop,mobile} = await test(url.value)
			if(!mobile || !desktop){
				if(message == 422){
					alert("URL invalida, resuerda usar HTTP o HTTPS")
				}
			}
			const img1 = createImage(mobile)
				if(!img1) return
				updateUI("mobile",img1)
			const img2 = createImage(desktop)
				if(!img2) return
				updateUI("desktop",img2)
		})
		setTimeout(() => {
			btnTest.disabled = false
		}, 2000)
	
	}

	const test= async (url:string) => {
		
		const res = await fetch('/api/test',{
			method: 'POST',
			headers: {
				'Content-Type': 'application/json'
			},
			body: JSON.stringify({
				url
			})
		})
		if(!res.ok){
			return {
				message: res.status
			}
		}
		const resp = await res.json()
		return resp
	}
	const updateUI = (idElement:string,imageElement:HTMLImageElement)=>{
		const resultEl = document.getElementById(idElement)
		if(!resultEl || !imageElement) return
		resultEl.innerHTML = ""
		resultEl.appendChild(imageElement)
	}

	const createImage = (url:string)=>{
		const img = document.createElement('img')
		img.src = url
		img.style.width = '100%'
		img.style.height = 'auto'
		img.style.objectFit = 'contain'
		return img
	}
</script>